{
 "title": "Leonid dust-trail simulations for the 2030s",
 "description": "Result files behind the Leonid forecasts and hindcasts of Abe (2026). Data only: neither the model source code nor the viewer application is part of this release. The files are in the dataset format read by the Meteorium app.",
 "version": "leonids-2030s-v1",
 "model": {
  "integrator": "REBOUND IAS15 with REBOUNDx radiation forces",
  "units": "AU / day / GM (G=1), heliocentric ecliptic J2000",
  "ejection": "Crifo & Rodionov (1997) gas-drag terminal velocity; grain sizes drawn from dN proportional to a^-u",
  "beta_max": 0.003,
  "beta_max_note": "BETA_VIS_MAX default; no per-run override was set (recorded as null in the dataset headers)",
  "ejection_sites": "anchored to the JPL Horizons ephemeris of 55P for each apparition (see the paper, Sect. 2.2)",
  "empirical_density_factor_sol_corr_old": 0.11
 },
 "layout": "Paths are relative to this file.  On Zenodo the same files are deposited flat, under the basename given as zenodo_name; the basenames are unique across the release.",
